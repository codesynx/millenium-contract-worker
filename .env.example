# Upstash Redis Configuration (use Redis URL, not REST URL for BullMQ)
REDIS_URL=redis://default:your_password@your-redis-host:6379

# Google Cloud Storage Configuration
GCS_PRIVATE_BUCKET_NAME=millenium-private
GCS_PROJECT_ID=your_project_id
GCS_CLIENT_EMAIL=your_service_account_email
GCS_PRIVATE_KEY="your_private_key"

# Database Configuration (for updating contract records)
DATABASE_URL=postgresql://user:password@host:5432/database

# Telegram Bot Configuration (for sending contracts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Worker Configuration
WORKER_CONCURRENCY=10
